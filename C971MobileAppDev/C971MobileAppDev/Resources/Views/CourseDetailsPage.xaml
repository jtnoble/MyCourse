<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:C971MobileAppDev.Resources.Views.Controls"
             x:Class="C971MobileAppDev.Resources.Views.CourseDetailsPage"
             Title="Course Details">

    <ScrollView>

        <Grid Padding="15"
              RowSpacing="12"
              ColumnDefinitions="*"
              RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              >

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                <Label Text="{Binding CurrentCourse.ClassName}"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"
                       Grid.Column="0"
                       />

                <Button Text="Edit"
                        Grid.Column="1"
                        Clicked="EditCourseClicked"
                        />
            </Grid>

            <Label Text="{Binding CurrentCourse.Status}"
                   Grid.Row="1"
                   HorizontalOptions="Center"
                   />

            <!-- Date display -->
            <Label Grid.Row="2"
                   HorizontalOptions="Center"
                   >
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CurrentCourse.StartDate, StringFormat='{0:d}'}"/>
                        <Span Text=" - "/>
                        <Span Text="{Binding CurrentCourse.EndDate, StringFormat='{0:d}'}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Progress bar moved to its own row (Grid.Row=3) to avoid overlap -->
            <controls:DateRangeProgressBar Grid.Row="3"
                                           StartDate="{Binding CurrentCourse.StartDate}"
                                           EndDate="{Binding CurrentCourse.EndDate}"
                                           Margin="0,6,0,0"/>

            <Label Text="Assessments:"
                   FontAttributes="Bold"
                   Grid.Row="4"
                   />

            <CollectionView Grid.Row="5"
                            ItemsSource="{Binding Assessments}"
                            >

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame BorderColor="Gray"
                               Padding="8"
                               Margin="0,5"
                               >

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AssessmentTapped"
                                                      NumberOfTapsRequired="1"
                                                      />
                            </Frame.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  >

                                <Label Text="{Binding Name}"
                                       Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       FontAttributes="Bold"
                                       />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding DueDate, StringFormat='Due: {0:d}'}"
                                       />

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Type}"
                                       />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button Text="Add Objective Assessment"
                    Grid.Row="6"
                    HorizontalOptions="Center"
                    Clicked="AddObjectiveClicked"
                    IsVisible="{Binding CanAddObjective}"
                    />
            <Button Text="Add Performance Assessment"
                    Grid.Row="7"
                    HorizontalOptions="Center"
                    Clicked="AddPerformanceClicked"
                    IsVisible="{Binding CanAddPerformance}"
                    />

            <Label Text="Notes:"
                   Grid.Row="8"
                   />

            <ScrollView Grid.Row="9"
                        HeightRequest="120">
                <Label Text="{Binding CurrentCourse.Notes, Mode=TwoWay}"
                       LineBreakMode="WordWrap"
                       />
            </ScrollView>
            <Button Text="Share Notes"
                Grid.Row="10"
                WidthRequest="120"
                Clicked="ShareNotesClicked"
                />

            <Label Grid.Row="11"
                   HorizontalOptions="Center"
                   >
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CurrentCourse.InstructorName}"/>
                        <Span Text="&#10;"/>
                        <Span Text="{Binding CurrentCourse.InstructorPhone}"/>
                        <Span Text=" - "/>
                        <Span Text="{Binding CurrentCourse.InstructorEmail}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </Grid>

    </ScrollView>

</ContentPage>