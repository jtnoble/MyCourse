<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:C971MobileAppDev.Resources.Views.Controls"
             x:Class="C971MobileAppDev.MainPage"
             x:Name="ThisPage"
             >

    <NavigationPage.TitleView>
        <Grid HorizontalOptions="Fill">
            <Label Text="MyCourse"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="Black"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    />
        </Grid>
    </NavigationPage.TitleView>

    <Grid RowDefinitions="Auto, Auto, Auto, *"
          Padding="10"
          RowSpacing="10">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, *, *"
              VerticalOptions="Center"
              >

            <Button Text="{Binding PreviousTermText}"
                    TextColor="Black"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Clicked="PreviousTermClicked"
                    />

            <Button Text="{Binding CurrentTerm.Name}"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontAttributes="Bold"
                    Clicked="EditTermClicked"
                   />

            <Button Text="{Binding NextTermText}"
                    TextColor="Black"
                    Grid.Column="2"
                    Background="Transparent"
                    Clicked="NextTermClicked"
                    />

        </Grid>

        <controls:DateRangeProgressBar Grid.Row="1"
                                       StartDate="{Binding CurrentTerm.StartDate}"
                                       EndDate="{Binding CurrentTerm.EndDate}"
                                       Margin="0,4,0,0"/>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="8">
            <SearchBar Placeholder="Search classes or instructors..."
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}"
                       Grid.Column="0" />

            <Button Text="Export Term Report"
                    Grid.Column="1"
                    Clicked="ExportReportClicked" />
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Courses}"
                        SelectionMode="None"
                        >
            <CollectionView.Footer>
                <VerticalStackLayout Padding="10">
                    <Button Text="Add Class"
                        HeightRequest="50"
                        HorizontalOptions="Fill"
                        Clicked="AddCourseClicked"
                        IsEnabled="{Binding CanAddCourse}"
                        />
                    <!--  EXAMPLE DATA TESTING, LEAVE FOR DEBUG REASONS ONLY                  
                    <Button Text="Create Example Data"
                        Margin="10"
                        HeightRequest="50"
                        HorizontalOptions="Fill"
                        Clicked="CreateExampleData"
                        />
                    -->
                </VerticalStackLayout>

            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BorderColor="Black"
                           Padding="10"
                           Margin="0, 5"
                           CornerRadius="10"
                           HasShadow="True">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="{Binding ClassName}"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"
                                   />

                            <Label FontSize="14"
                                   HorizontalOptions="Center"
                                   >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding StartDate, StringFormat='{0:d}'}"/>
                                        <Span Text=" - "/>
                                        <Span Text="{Binding EndDate, StringFormat='{0:d}'}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <controls:DateRangeProgressBar StartDate="{Binding StartDate}"
                                                           EndDate="{Binding EndDate}" />

                            <Button Text="View Class"
                                    HorizontalOptions="Center"
                                    WidthRequest="150"
                                    Clicked="ViewCourseClicked"
                                   />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>



    </Grid>

</ContentPage>